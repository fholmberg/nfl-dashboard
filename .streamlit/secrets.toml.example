# Copy into Streamlit Cloud -> Settings -> Secrets (never commit the real file)
# Optional: set app_password to gate the board; omit it for a public,
# read-only board. R2 keys must be a read-only token (Object Read).
# app_password = "change-me"
r2_access_key_id = ""
r2_secret_access_key = ""
r2_s3_host = "<account-id>.r2.cloudflarestorage.com"
r2_bucket = "nfl"
r2_bucket_ncaaf = "ncaaf"
